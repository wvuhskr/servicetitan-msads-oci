name = "st-msads-oci-worker"
main = "src/worker.js"
compatibility_date = "2026-07-01"
workers_dev = false
account_id = "YOUR_CLOUDFLARE_ACCOUNT_ID"

routes = [{ pattern = "oci.yourdomain.com", custom_domain = true }]

[vars]
ALLOWED_ORIGIN = "https://www.yourdomain.com,https://yourdomain.com"

[observability]
enabled = true

[[kv_namespaces]]
binding = "OCI"
id = "YOUR_KV_NAMESPACE_ID"   # wrangler kv namespace create OCI

# Optional per-IP rate limit on the beacon endpoint (Workers paid plan). Delete if unavailable.
[[unsafe.bindings]]
name = "RL"
type = "ratelimit"
namespace_id = "1001"
simple = { limit = 60, period = 60 }
