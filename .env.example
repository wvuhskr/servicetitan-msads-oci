# ServiceTitan API app (https://developer.servicetitan.io) — read-only scopes are enough
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_APP_KEY=
# Bearer token you set on the Worker (wrangler secret put OCI_BEARER)
OCI_WORKER_BEARER=
# Optional notifiers — leave blank to disable
NOTIFY_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
GRAPH_TO=
